---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPosts, readingTime } from '@/lib/utils';
import { site } from '@/site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, tags, draft } = post.data;
---

<BaseLayout title={title} description={description} type="article" publishedTime={date}>
  <article class="container-prose post">
    <header class="post-head">
      <p class="eyebrow"><a href="/blog/">Blog</a></p>
      <h1>{title}</h1>
      <p class="meta">
        <span>By {site.name}</span>
        <span aria-hidden="true">·</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
        {updated && <> · Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        {draft && <span class="badge badge--accent">Draft (not published)</span>}
      </p>
      {tags.length > 0 && <ul class="tags" aria-label="Tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>}
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More posts">
      {newer ? <a href={`/blog/${newer.id}/`} rel="prev"><span>← Newer</span>{newer.data.title}</a> : <span />}
      {older && <a href={`/blog/${older.id}/`} rel="next" class="older"><span>Older →</span>{older.data.title}</a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .post { padding-block: clamp(2rem, 6vw, 4rem); }
  .post-head { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  .eyebrow a { color: inherit; text-decoration: none; }
  .meta { color: var(--muted); font-size: 0.95rem; display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager a { display: flex; flex-direction: column; font-weight: 600; max-width: 48%; }
  .pager span { font-size: 0.85rem; font-weight: 500; color: var(--muted); }
  .pager .older { text-align: right; margin-left: auto; }
</style>
