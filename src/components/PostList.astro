---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '@/lib/utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
  headingLevel?: 'h2' | 'h3';
}
const { posts, headingLevel: H = 'h3' } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post) => (
      <li class="card post">
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)}</span>
          {post.data.draft && <span class="badge badge--accent">Draft</span>}
        </p>
        <H class="title">
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </H>
        <p class="desc">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {post.data.tags.map((t) => <li class="tag">{t}</li>)}
          </ul>
        )}
      </li>
    ))
  }
</ul>

<style>
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .post { position: relative; }
  .post:hover { border-color: var(--primary); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; color: var(--muted); font-size: 0.9rem; margin-bottom: 0.35rem; }
  .title { font-size: 1.3rem; margin-bottom: 0.4rem; }
  .title a { color: var(--text); text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .title a:hover { color: var(--primary); }
  .title a:focus-visible { outline: none; }
  .post:has(a:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .desc { color: var(--muted); margin-bottom: 0.75rem; }
</style>
